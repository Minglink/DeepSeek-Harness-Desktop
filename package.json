{
  "name": "dsh-desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness Desktop with one-click plugin install support (dsh://)",
  "author": "DeepSeek AI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deepseek.dsh-desktop",
    "productName": "DeepSeek Harness",
    "protocols": [
      {
        "name": "DeepSeek Harness Protocol",
        "schemes": [
          "dsh"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "installer.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node",
        "to": "node"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "compression": "normal",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "differentialPackage": false,
      "include": "build/installer.nsh"
    }
  }
}
