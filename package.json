{
  "name": "dsh-desktop",
  "version": "0.1.6-max",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness Desktop (0.1.6 Max Edition)",
  "author": "DeepSeek AI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deepseek.dsh-desktop",
    "productName": "DeepSeek Harness",
    "artifactName": "deepseek-harness 安装包 0.1.6 max.${ext}",
    "protocols": [
      {
        "name": "DeepSeek Harness Protocol",
        "schemes": [
          "dsh"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "installer.js",
      "api-vault.js",
      "market.html",
      "package.json",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "node",
        "to": "node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "lib/**/*",
          "config/**/*",
          "package.json"
        ]
      },
      {
        "from": "runtime/node_modules",
        "to": "runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "compression": "normal",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "differentialPackage": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}