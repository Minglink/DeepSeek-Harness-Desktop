{
  "name": "dsh-desktop",
  "version": "0.1.0-a",
  "private": true,
  "type": "module",
  "description": "Electron desktop shell for the DeepSeek Harness Web UI with one-click plugin install support (dsh://)",
  "author": "DeepSeek Harness",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deepseek.dsh-desktop",
    "productName": "DeepSeek Harness",
    "protocols": [
      {
        "name": "DeepSeek Harness Protocol",
        "schemes": [
          "dsh"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "installer.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node",
        "to": "node"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
